    | 52 => p052 (i % 64)
    | 53 => p053 (i % 64)
    | 54 => p054 (i % 64)
    | 55 => p055 (i % 64)
    | 56 => p056 (i % 64)
    | 57 => p057 (i % 64)
    | 58 => p058 (i % 64)
    | 59 => p059 (i % 64)
    | 60 => p060 (i % 64)
    | 61 => p061 (i % 64)
    | _ => []
  else []
theorem table_exact : (List.range 3947).map path = sites.toList.map (·.path) := by decide +kernel
theorem path_eq (i : Nat) : path i = SourceProgram.path i := by
  by_cases hi : i < 3947
  · have hh := congrArg (fun xs => xs[i]?) table_exact
    have hr : (List.range 3947)[i]? = some i := by simp [hi]
    have hs : sites.toList[i]? = sites[i]? := by simp
    simp only [List.getElem?_map,hr,Option.map_some,hs] at hh
    unfold SourceProgram.path
    rw [← hh]
    rfl
  · have hs : sites[i]? = none := Array.getElem?_eq_none_iff.mpr (by rw [sites_count]; omega)
    simp only [path,hi,ite_false,SourceProgram.path,hs,Option.map_none,Option.getD_none]

theorem path_short (i : Nat) : (path i).length ≤ 64 := by
  rw [path_eq]
  exact PA213.PathBounds.path_short i
end PA213.FastPaths
