import PA215.Source.ContractPlan
import PA215.Source.ExactSource
import PA215.Census.C000
set_option maxRecDepth 100000
set_option maxHeartbeats 2000000
namespace PA215.Source

def recordAgrees (r : PA215.Census.RawOriginal) : Bool :=
  match exactSites[r.siteIndex]? with
  | none => false
  | some s => agreesWith s r

/-- Original census IDs 0–127 are generated by the exact pinned source,
including their branch flags and both full physical frames. -/
theorem original_first128_agree :
    PA215.Census.C000.records.toList.all recordAgrees = true := by decide

theorem original_first128_record (r : PA215.Census.RawOriginal)
    (hr : r ∈ PA215.Census.C000.records.toList) : recordAgrees r = true :=
  List.all_eq_true.mp original_first128_agree r hr

#print axioms original_first128_record
#print axioms original_first128_agree
end PA215.Source
