theorem PA215.PA.InternalUnprovability.pa_proves_nonhalting_consistency : theory ⊢
  HaltingFormula.nonhaltingSentence 🡒 consistencySentence :=
have h :=
  Eq.mp
    (congrArg (Entails theory)
      (congr
        (congrArg HArrow.hArrow
          (Eq.trans
            (congrFun' (congrArg DFunLike.coe (congrArg Rewriting.app (Rew.subst_zero ![])))
              HaltingFormula.nonhaltingSentence)
            (ReflectiveRewriting.id_app HaltingFormula.nonhaltingSentence)))
        (Eq.trans
          (congrFun' (congrArg DFunLike.coe (congrArg Rewriting.app (Rew.subst_zero ![])))
            InternalActualRefutation.noActualRefutationSentence)
          (ReflectiveRewriting.id_app InternalActualRefutation.noActualRefutationSentence))))
    InternalActualRefutation.pa_proves_nonhalting_no_actual_refutation;
C_trans h InternalActualRefutation.pa_proves_no_actual_refutation_consistency
theorem PA215.PA.InternalUnprovability.nonhalting_unprovable : Consistent →
  theory ⊬ HaltingFormula.nonhaltingSentence :=
fun hcons => nonhalting_unprovable_of_internal_consistency_implication hcons pa_proves_nonhalting_consistency
'PA215.PA.InternalUnprovability.pa_proves_nonhalting_consistency' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'PA215.PA.InternalUnprovability.nonhalting_unprovable' depends on axioms: [propext, Classical.choice, Quot.sound]
