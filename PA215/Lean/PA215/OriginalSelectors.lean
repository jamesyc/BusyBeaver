theorem originalAt_C000 (j : Fin 128) :
    originalAt ⟨0 + j.val, by have := j.isLt; omega⟩ =
      C000.records[j.val]'(by rw [C000.size]; exact j.isLt) := by
  unfold originalAt all
  simp only [Array.append_assoc]
  rw [Array.getElem_append_left (by rw [C000.size]; have := j.isLt; omega)]
  congr 1 <;> omega

