theorem move_y_x (y w h x : Nat) (f : Registers) :
    Steps (3*y+1) (configAt 15 ⟨w, h, x, y, f⟩) (configAt 18 ⟨w, h, x + y, 0, f⟩) := by
  induction y generalizing x with
  | zero =>
    apply Steps.cons
    rw [step_15]
    try simp
    exact Steps.refl _
  | succ y ih =>
    have hn : 3*(y+1)+1 = (3*y+1)+1+1+1 := by omega
    rw [hn]
    apply Steps.cons
    rw [step_15]
    try simp
    apply Steps.cons
    rw [step_16]
    try simp
    apply Steps.cons
    rw [step_17]
    try simp
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using ih (x+1)

